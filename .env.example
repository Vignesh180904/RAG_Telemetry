# Copy to .env (PowerShell:  Copy-Item .env.example .env) and edit. No secrets are required.

# ---------------- Embeddings ----------------
# sentence-transformers | ollama | fastembed | hash
#   sentence-transformers  original backend; needs torch (pip install -r requirements-embeddings-st.txt)
#   ollama                 no Python ML deps: run `ollama pull all-minilm` (same MiniLM architecture)
#   fastembed              ONNX, no torch (pip install -r requirements-embeddings-onnx.txt)
#   hash                   tests/offline only -- poor retrieval quality
# Changing backend/model changes the vector space: use a NEW CHROMA_COLLECTION_NAME (the app refuses to mix).
# Default here is ollama because requirements.txt does not install torch. Run first:  ollama pull all-minilm
EMBEDDING_BACKEND=ollama
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_BATCH_SIZE=32

# ---------------- Ingestion ----------------
CHUNK_SIZE=500
CHUNK_OVERLAP=50
MAX_UPLOAD_MB=20
DOCUMENTS_DIR=./data/documents

# ---------------- Retrieval ----------------
TOP_K=3
# hybrid | dense | sparse
RETRIEVAL_MODE=hybrid
DENSE_CANDIDATES=10
SPARSE_CANDIDATES=10
RRF_K=60
DEDUPE_THRESHOLD=0.9
# none | cross-encoder (needs fastembed or sentence-transformers; +latency)
RERANKER=none
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# ---------------- Vector store ----------------
CHROMA_PERSIST_DIR=./chroma_db
# New name so a chroma_db built by the original project (sentence-transformers vectors) is never mixed in.
CHROMA_COLLECTION_NAME=rag_documents_v2

# ---------------- LLMs ----------------
# mock = deterministic test stand-in (no model). ollama = local models (recommended).
LLM_PROVIDER=mock
OLLAMA_BASE_URL=http://localhost:11434
# Default model for every role that is left blank below. Pick from `ollama list`.
OLLAMA_MODEL=llama3.2:3b
GENERATOR_MODEL=
VERIFIER_MODEL=
SYNTHESIZER_MODEL=
ROUTER_MODEL=
# Limits (8 GB RAM: keep NUM_CTX at 2048-4096 and use 1B-4B quantized models)
LLM_TIMEOUT_S=120
LLM_MAX_RETRIES=1
LLM_RETRY_BACKOFF_S=1
LLM_NUM_CTX=4096
LLM_NUM_PREDICT=512
LLM_TEMPERATURE=0.1
# "0" asks Ollama to unload right after each call (least RAM, slower when roles use different models)
LLM_KEEP_ALIVE=5m

# ---------------- Agent / routing ----------------
# dense similarity gate (tune per embedding model with evaluate.py)
AGENT_RELEVANCE_THRESHOLD=0.30
# OR: share of query words found in a chunk (>= 2 words)
AGENT_COVERAGE_THRESHOLD=0.5
# query rewrites on weak retrieval
AGENT_MAX_RETRIES=1
# rules | llm
AGENT_ROUTER=rules
AGENT_GROUNDING_THRESHOLD=0.5
# auto | simple | complex  (force a route for experiments)
COMPLEXITY_MODE=auto
# extra verifier passes when evidence conflicts
MAX_EXTRA_VERIFICATIONS=1

# ---------------- Telemetry ----------------
SERVICE_NAME=rag-telemetry-evals
LOG_LEVEL=INFO
# none | console | otlp
TRACE_EXPORTER=none
# e.g. http://localhost:4318/v1/traces  (pip install -r requirements-otlp.txt)
OTLP_ENDPOINT=
METRICS_CONSOLE_EXPORT=false
TELEMETRY_LOG_PATH=./outputs/telemetry_log.jsonl
# false = store only a hash + length of each question
TELEMETRY_LOG_QUERY_TEXT=false

# ---------------- Evaluation ----------------
EVAL_DATASET_PATH=./data/evaluation/eval_dataset_v2.json
EVAL_OUTPUT_DIR=./outputs
EVAL_LLM_JUDGE=false

# ---------------- API ----------------
CORS_ORIGINS=["http://localhost:8000","http://127.0.0.1:8000"]
